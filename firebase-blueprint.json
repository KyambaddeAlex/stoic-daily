{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile and role assignment for registered practitioners and administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "mentor", "practitioner"] },
        "createdAt": { "type": "string" },
        "lastActive": { "type": "string" },
        "streakCount": { "type": "number" },
        "reflectionCount": { "type": "number" },
        "mentorGuidance": { "type": "string", "maxLength": 1000 },
        "adminNotes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "DailyReflection": {
      "title": "DailyReflection",
      "description": "Daily Stoic reflections, morning intentions, dichotomy of control items, and Seneca self-audits",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "morningIntentions": { "type": "string", "maxLength": 1000 },
        "anticipatedChallenge": { "type": "string", "maxLength": 1000 },
        "ambitions": { "type": "array" },
        "dichotomyItems": { "type": "array" },
        "eveningReflection": { "type": "string", "maxLength": 2000 },
        "self_audit_well": { "type": "string", "maxLength": 1000 },
        "self_audit_short": { "type": "string", "maxLength": 1000 },
        "lessonsLearned": { "type": "string", "maxLength": 1000 },
        "habitCurbed": { "type": "string", "maxLength": 500 },
        "dailyWins": { "type": "array" },
        "serenityRating": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "date"]
    },
    "StoicQuote": {
      "title": "StoicQuote",
      "description": "Curated philosophical Stoic quotes managed via administrator CMS",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 1000 },
        "author": { "type": "string", "maxLength": 100 },
        "source": { "type": "string", "maxLength": 150 },
        "virtue": { "type": "string", "enum": ["wisdom", "courage", "justice", "temperance"] },
        "application": { "type": "string", "maxLength": 1000 },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["text", "author"]
    },
    "CommunityBroadcast": {
      "title": "CommunityBroadcast",
      "description": "Global administrator announcement or weekly challenge for all practitioners",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["notice", "challenge", "quote"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message", "active"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Security and administrative activity log",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string", "maxLength": 256 },
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string" }
      },
      "required": ["adminEmail", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account document containing profile, role, and mentor guidance"
    },
    "/users/{userId}/reflections/{date}": {
      "schema": { "$ref": "#/entities/DailyReflection" },
      "description": "Private daily reflections belonging to the user, viewable by user and administrator"
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/StoicQuote" },
      "description": "Public Stoic quotes readable by authenticated users and writable by administrators"
    },
    "/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/CommunityBroadcast" },
      "description": "Public community announcements readable by all, managed by administrators"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Administrative activity log entries writable by administrators"
    }
  }
}
